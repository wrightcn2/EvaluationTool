          label.col-10.col-sm-2.col-form-label(for="introduction") Rating for Introduction
          .col-12.col-sm-2
            select#rating.form-control.input-sm(name="introduction")          
              option 4                                                  
              option 3                                                  
              option 2                                                  
              option 1                                                  
