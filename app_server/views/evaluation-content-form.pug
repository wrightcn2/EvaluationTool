extends layout

block content
  .row.banner
    .col-12
      h1= pageHeader.title
  .row
    .col-12.col-md-12
      form(action="", method="post", role="form") 
        .form-group.row 
          h4
            a(href='/evaluation/content/info') More Information                                 
