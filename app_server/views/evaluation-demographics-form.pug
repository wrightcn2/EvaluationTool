extends layout

block content
  .row.banner
    .col-12
      h1 Comment on MEAN Full Stack Final Project - Project Demographics:
  .row
    .col-12.col-md-12
      form(action="/evaluation", method="get", role="form")   
        .form-group.row
          label.col-10.col-sm-3.col-form-label(for="information") Group Project Members:
          .col-sm-8
            textarea#review.form-control(name="comment", rows="1")  
        .form-group.row

        .form-group.row
          label.col-10.col-sm-3.col-form-label(for="information") Today's Date:
          .col-sm-8
            textarea#review.form-control(name="comment", rows="1")  
        .form-group.row

        .form-group.row
          label.col-10.col-sm-3.col-form-label(for="information") Evaluator's Name: 
          .col-sm-8
            textarea#review.form-control(name="comment", rows="1") 
        .form-group.row

        .form-group.row
          label.col-10.col-sm-3.col-form-label(for="information") Title of Evaluation: 
          .col-sm-8
            textarea#review.form-control(name="comment", rows="1") 
        .form-group.row

        .form-group.row
          label.col-sm-3.col-form-label(for="comment") Comment:
          .col-sm-10
            textarea#review.form-control(name="comment", rows="3")       
        button.btn.btn-primary.float-right Add my comment                
    .col-12.col-md-4

