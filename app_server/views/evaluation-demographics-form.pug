extends layout

block content
  .row.banner
    .col-12
      h1= pageHeader.title
  .row
    .col-12.col-md-12
      form(action="", method="post", role="form")   
        .form-group.row
          label.col-10.col-sm-3.col-form-label(for="groupMembers") Group Project Members:
          .col-sm-8
            textarea#review.form-control(name="groupMembers", rows="1")  
        .form-group.row

        .form-group.row
          label.col-10.col-sm-3.col-form-label(for="date") Today's Date:
          .col-sm-8
            textarea#review.form-control(name="date", rows="1")  
        .form-group.row

        .form-group.row
          label.col-10.col-sm-3.col-form-label(for="evaluatorName") Evaluator's Name: 
          .col-sm-8
            textarea#review.form-control(name="evaluatorName", rows="1") 
        .form-group.row

        .form-group.row
          label.col-10.col-sm-3.col-form-label(for="title_pres") Title of Evaluation: 
          .col-sm-8
            textarea#review.form-control(name="title_pres", rows="1")  
        .form-group.row   
        button.btn.btn-primary.float-right Add The Demographics                          
    .col-12.col-md-4

