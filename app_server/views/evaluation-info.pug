extends layout

include _includes/sharedHTMLfunctions


block content
  .row.banner
    .col-12
      h1= pageHeader.title
  .row
    .col-12.col-lg-9
      .row
        .col-12.col-md-12 
          h3.rating Overall Rating:  
            +outputRating(evaluation.rating)
            <br><br>
          .card.card-primary
            .card-block
              h2.card-title Name(s): 
                h4=evaluation.names
          .card.card-primary
            .card-block
              h2.card-title Project Characteristics
              each characteristic in evaluation.characteristics
                span.badge.badge-warning
                  i.fa.fa-check
                  | &nbsp;#{characteristic}
                | &nbsp;
          .card.card-primary
            .card-block
              a.btn.btn-primary.float-right(href=`/evaluation/${evaluation._id}/demographics/new`) Add Demographics
              h2 Project Demographics:
              each demographic in evaluation.demographics
                p.card-text Group Project Members:
                  .col-12
                    p.demographic= demographic.groupMembers 
                p.card-text Today's Date: 
                  .col-12
                    p.demographic= demographic.date
                p.card-text Evaluator's Name:
                  .col-12
                    p.demographic= demographic.evaluatorName
                p.card-text Title of Evaluation:
                  .col-12
                    p.demographic= demographic.title_pres
          .card.card-primary
            .card-block
              a.btn.btn-primary.float-right(href=`/evaluation/${evaluation._id}/content/new`) Add Content Ratings
              h2 Project Content:
              each content in evaluation.content
                p.card-text Introduction: 
                  +outputRating(content.introduction)
                p.card-text Organization Of Content:  
                  +outputRating(content.organization)
                p.card-text Time Frame:  
                  +outputRating(content.timeFrame)
                p.card-text Visual Aid:  
                  +outputRating(content.visualAid)
                p.card-text Knowledge and Preparation:  
                  +outputRating(content.preparation)
          .card.card-primary
            .card-block
              a.btn.btn-primary.float-right(href=`/evaluation/${evaluation._id}/skills/new`) Add Verbal Ratings
              h2 Verbal Skills:
              each verbal in evaluation.skills
                p.card-text Enthusiasm and Motivation:  
                  +outputRating(verbal.enthusiasm)
                p.card-text Elocution:  
                  +outputRating(verbal.elocution)
                p.card-text Vocal Pauses:  
                  +outputRating(verbal.vocalPause)
          .card.card-primary
            .card-block
              a.btn.btn-primary.float-right(href=`/evaluation/${evaluation._id}/nonverbal/new`) Add NonVerbal Ratings
              h2 Non-verbal Skills:
              each nonVerbal in evaluation.nonverbal
                p.card-text Eye Contact:  
                  +outputRating(nonVerbal.eyeContact)
                p.card-text Gestures:  
                   +outputRating(nonVerbal.gestures)
      .row
        .col-12
          .card.card-primary.review-card
            .card-block
              a.btn.btn-primary.float-right(href=`/evaluation/${evaluation._id}/comment/new`) Add comment
              h2.card-title Past comments
              each comment in evaluation.comments
                .row.review
                  .col-12.no-gutters.review-header
                    span.rating
                      +outputRating(comment.rating)
                    span.reviewAuthor #{comment.author}
                    small.reviewTimestamp   
                      +formatDate(comment.createdOn)
                  .col-12
                    p= comment.commentText
    .col-12.col-lg-3
      p.lead #{evaluation.name} #{sidebar.context}
      p= sidebar.callToAction