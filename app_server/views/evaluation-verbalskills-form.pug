extends layout

block content
  .row.banner
    .col-12
      h1 Comment on MEAN Full Stack Final Project - Verbal Skills:
  .row
    .col-12.col-md-8
      form(action="/evaluation", method="get", role="form")
        .form-group.row 
          h4
            a(href='/evaluation/skills/info') More Information                                  
        .form-group.row
          label.col-10.col-sm-5.col-form-label(for="rating") Rate Ethusiasm and Motivation
          .col-12.col-sm-2
            select#rating.form-control.input-sm(name="rating")          
              option 4                                                  
              option 3                                                  
              option 2                                                  
              option 1                                                  
        .form-group.row
        .form-group.row
          label.col-10.col-sm-5.col-form-label(for="rating") Rate Elocution
          .col-12.col-sm-2
            select#rating.form-control.input-sm(name="rating")          
              option 4                                                  
              option 3                                                  
              option 2                                                  
              option 1                                                  
        .form-group.row
        .form-group.row
          label.col-10.col-sm-5.col-form-label(for="rating") Rate Vocal Pauses
          .col-12.col-sm-2
            select#rating.form-control.input-sm(name="rating")          
              option 4                                                  
              option 3                                                  
              option 2                                                  
              option 1                                                  
        .form-group.row
          label.col-sm-5.col-form-label(for="comment") Comment:
          .col-sm-10
            textarea#review.form-control(name="comment", rows="5")       
        button.btn.btn-primary.float-right Add my comment                
    .col-12.col-md-4