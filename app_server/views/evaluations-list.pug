extends layout

include _includes/sharedHTMLfunctions

block content
  .row.banner
    .col-12
      h1=pageHeader.title
        small &nbsp;#{pageHeader.strapline}
        a.btn.btn-primary.btn-lg.float-right(href='/evaluation/new') Create New Evaluation

  .row
    .col-12.col-md-8
      .error= message 

      each evaluation in evaluations 
        .card 
          .card-block 
            h4 
              a(href=`/evaluation/${evaluation._id}`)=evaluation.title 
              div(style="float: right") Overall Rating: 
                +outputRating(evaluation.rating)
            p.names=evaluation.names 
            .characteristics 
              each characteristic in evaluation.characteristics 
                span.badge.badge-warning=characteristic 

    .col-12.col-md-4
      p.lead Looking for a way to evaluate something with ease? <br><br> Evaluation Tool helps you do just that. All digital and easy to use! Let EvaluationTool help you assess the things you're looking for.